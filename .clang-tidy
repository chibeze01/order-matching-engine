# Relaxed enough not to scream at scaffolding. Tightened as real code lands.
# Not enforced in CI yet; the format job only runs clang-format.
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -modernize-use-nodiscard
WarningsAsErrors: ''
HeaderFilterRegex: '(engine|sim|gateway|bench)/.*'
FormatStyle: file
